# La SPA consume siempre la API del mismo origen. Vite (en dev, vía proxy) y Nginx
# (en producción) resuelven el resto — ver vite.config.ts y nginx.conf.
VITE_API_BASE_URL=/api

# Destino del proxy de Vite en desarrollo (opcional):
# - Por defecto (backend corriendo nativo con ./mvnw spring-boot:run): http://localhost:8080
# - Si el backend corre dentro de Docker Compose: http://localhost:8081
# VITE_BACKEND_PROXY_TARGET=http://localhost:8080

