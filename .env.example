# Copia este archivo a .env y ajusta los valores. .env NUNCA se versiona (ver .gitignore).
# Referenciado por docker-compose.yml y por .mcp.json (servidor mongodb, Sprint 1).

# --- Backend (Spring Boot) ---
SPRING_PROFILES_ACTIVE=docker
SERVER_PORT=8080

# --- MongoDB ---
MONGODB_URI=mongodb://mongo:27017/aguavigia
MONGO_INITDB_DATABASE=aguavigia
# Solo para docker-compose.prod.yml. Usa credenciales distintas de cualquier cuenta personal y
# codifica caracteres especiales de usuario/clave dentro de la URI.
MONGO_ROOT_USERNAME=
MONGO_ROOT_PASSWORD=
MONGODB_URI_PROD=

# --- Redis (cache, rate limiting, ventana de consenso, pub/sub) ---
REDIS_HOST=redis
REDIS_PORT=6379
# Obligatoria únicamente en producción; el compose local mantiene Redis sin clave.
REDIS_PASSWORD=

# --- Mailhog (SMTP de pruebas, M4 alertas por correo) ---
MAIL_HOST=mailhog
MAIL_PORT=1025
MAIL_FROM=no-reply@aguavigia.local

# --- Identificacion del colector (ver CLAUDE.md, etica de datos, punto 3) ---
# El colector SIEMPRE se identifica. Correo de contacto real definido 2026-08-08 (BL-006).
COLLECTOR_USER_AGENT=AguaVigiaCTG-Bot/1.0 (+rafasarmiento777@gmail.com)
# Cada cuanto corre el ciclo de ingesta (M9), en milisegundos. 600000 = 10 minutos.
INGESTA_INTERVALO_MS=600000

# --- Seguridad (panel del veedor, M5 — RF019, RNF011, ADR-039) ---
# Firma del JWT. HS256 exige minimo 32 bytes. Generarlo con: openssl rand -base64 32
JWT_SECRET=
# Hash BCrypt de la clave del PRIMER administrador — nunca la clave en texto plano. Generarlo
# corriendo GenerarHashVeedor (backend/src/test/.../infrastructure/security/GenerarHashVeedor.java)
# desde el IDE con tu clave como argumento.
#
# Desde ADR-039 ya no es una credencial compartida: al arrancar con la base de datos vacia,
# SembradorAdminInicial crea con ella la cuenta ADMIN de ADMIN_INICIAL_CORREO. En cuanto existe
# alguna cuenta deja de usarse — a partir de ahi cada persona tiene su correo y su clave.
VEEDOR_PASSWORD_HASH=
# Correo del primer administrador. Sin el no se siembra nadie y el panel queda sin acceso.
# Esa cuenta nace ADMIN, y el rol ADMIN exige segundo factor: su primera sesion solo sirve para
# dar de alta el TOTP.
ADMIN_INICIAL_CORREO=
# Clave compartida para sensores IoT (M13). Vacía por defecto: responde 503 hasta que se configure.
IOT_KEY=

# --- Enlaces de los correos ---
# Base publica desde la que se arman los enlaces que salen por correo (confirmar suscripcion,
# verificar cuenta, aceptar invitacion, restablecer clave). Debe apuntar al SITIO, no a la API:
# es el frontend quien pinta esas pantallas y luego llama al backend con el token.
APP_URL_PUBLICA=http://localhost:5173

# --- Frontend (Vite) ---
VITE_API_BASE_URL=/api

# --- GitHub (servidor MCP $disabled_github en .mcp.json, opcional) ---
GITHUB_PERSONAL_ACCESS_TOKEN=
