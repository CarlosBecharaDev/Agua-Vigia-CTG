# Copia este archivo a .env y ajusta los valores. .env NUNCA se versiona (ver .gitignore).
# Referenciado por docker-compose.yml y por .mcp.json (servidor mongodb, Sprint 1).

# --- Backend (Spring Boot) ---
SPRING_PROFILES_ACTIVE=docker
SERVER_PORT=8080

# --- MongoDB ---
MONGODB_URI=mongodb://mongo:27017/aguavigia
MONGO_INITDB_DATABASE=aguavigia

# --- Redis (cache, rate limiting, ventana de consenso, pub/sub) ---
REDIS_HOST=redis
REDIS_PORT=6379

# --- Mailhog (SMTP de pruebas, M4 alertas por correo) ---
MAIL_HOST=mailhog
MAIL_PORT=1025
MAIL_FROM=no-reply@aguavigia.local

# --- Anthropic (pipeline de ingesta M9, modelo claude-opus-5) ---
# No compartir: cada persona usa su propia clave de desarrollo.
ANTHROPIC_API_KEY=

# --- Identificacion del colector (ver CLAUDE.md, etica de datos, punto 3) ---
# El colector SIEMPRE se identifica. Ajustar con el correo de contacto real del equipo antes de Sprint 4.
COLLECTOR_USER_AGENT=AguaVigiaCTG-Bot/1.0 (+correo-de-contacto-del-equipo@pendiente)

# --- Seguridad ---
JWT_SECRET=

# --- Frontend (Vite) ---
VITE_API_BASE_URL=http://localhost:8080/api

# --- GitHub (servidor MCP $disabled_github en .mcp.json, opcional) ---
GITHUB_PERSONAL_ACCESS_TOKEN=
